# Environment Configuration for DB-Stream
# Copy this file to .env and update values as needed

# Service Configuration
SERVER_PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=db-stream-group

# Database Configuration (PostgreSQL - Source)
DB_HOST=localhost
DB_PORT=5432
DB_USER=db_stream
DB_PASSWORD=db_stream_password
DB_NAME=db_stream_source

# ClickHouse Configuration (Analytics)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=db_stream_analytics

# Redis Configuration (Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# MinIO Configuration (Object Storage)
MINIO_ENDPOINT=localhost:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=db-stream-files

# Spark Configuration
SPARK_MASTER_URL=spark://localhost:7077
SPARK_APP_NAME=db-stream-processor

# Development Environment
GO_ENV=development
AIR_ROOT_PATH=.